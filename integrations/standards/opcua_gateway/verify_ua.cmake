# Verify the imported dependency that will actually be linked, not a guessed file.
if(NOT D1_UA_PREFIX)
    message(FATAL_ERROR "D1 requires the recorded open62541 installation prefix")
endif()
get_target_property(d1_ua_type open62541::open62541 TYPE)
get_target_property(d1_ua_library open62541::open62541 IMPORTED_LOCATION_RELEASE)
get_target_property(d1_ua_includes open62541::open62541 INTERFACE_INCLUDE_DIRECTORIES)
file(REAL_PATH "${D1_UA_PREFIX}/lib/open62541.lib" d1_expected_library)
file(REAL_PATH "${D1_UA_PREFIX}/include" d1_expected_include)
file(REAL_PATH "${d1_ua_library}" d1_actual_library)
if(NOT d1_ua_type STREQUAL "STATIC_LIBRARY" OR NOT d1_actual_library STREQUAL d1_expected_library)
    message(FATAL_ERROR "Resolved open62541 library is outside the recorded installation")
endif()
set(d1_include_found FALSE)
foreach(d1_ua_include IN LISTS d1_ua_includes)
    file(REAL_PATH "${d1_ua_include}" d1_actual_include)
    if(NOT d1_actual_include STREQUAL d1_expected_include)
        message(FATAL_ERROR "Resolved open62541 includes are outside the recorded installation")
    endif()
    set(d1_include_found TRUE)
endforeach()
if(NOT d1_include_found)
    message(FATAL_ERROR "Missing recorded open62541 include directory")
endif()
file(SHA256 "${d1_actual_library}" d1_ua_sha)
file(WRITE "${CMAKE_BINARY_DIR}/d1-ua-dependency.json"
    "{\"library\":\"${d1_actual_library}\",\"include\":\"${d1_expected_include}\",\"sha256\":\"${d1_ua_sha}\"}\n")
