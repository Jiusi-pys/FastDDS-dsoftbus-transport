@PACKAGE_INIT@
if(NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR NOT OHOS_STL STREQUAL "c++_shared")
    message(FATAL_ERROR "Installed stock product requires OHOS with the declared shared SDK C++ runtime")
endif()
include(CMakeFindDependencyMacro)
find_dependency(@_stock_fastdds_target@ @_stock_fastdds_release@ EXACT CONFIG)
find_dependency(fastcdr @_stock_fastcdr_release@ EXACT CONFIG)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/FastDDSDSoftBusStockTargets.cmake")
check_required_components(FastDDSDSoftBusStock)
