# Replaces CMake's FindPython3 when ROS builds for OpenHarmony. The host interpreter runs the generators, and the extension
# modules compile against the target Python. CMake's own module cannot express that split under cross compilation, so this
# file sits first on CMAKE_MODULE_PATH: no ROS source changes. Values come from Ros2PythonTarget.cmake.
if(NOT OHOS_PYTHON_INCLUDE OR NOT OHOS_PYTHON_LIBRARY OR NOT OHOS_NUMPY_INCLUDE OR NOT OHOS_PYTHON_HOST)
    message(FATAL_ERROR "Python target inputs are not set: the build must include Ros2PythonTarget.cmake")
endif()

if(NOT TARGET Python3::Interpreter)
    add_executable(Python3::Interpreter IMPORTED GLOBAL)
    set_target_properties(Python3::Interpreter PROPERTIES IMPORTED_LOCATION "${OHOS_PYTHON_HOST}")
endif()
if(NOT TARGET Python3::Python)
    add_library(Python3::Python SHARED IMPORTED GLOBAL)
    set_target_properties(Python3::Python PROPERTIES IMPORTED_LOCATION "${OHOS_PYTHON_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${OHOS_PYTHON_INCLUDE}")
endif()
if(NOT TARGET Python3::Module)
    add_library(Python3::Module INTERFACE IMPORTED GLOBAL)
    set_target_properties(Python3::Module PROPERTIES INTERFACE_LINK_LIBRARIES Python3::Python)
endif()
if(NOT TARGET Python3::NumPy)
    add_library(Python3::NumPy INTERFACE IMPORTED GLOBAL)
    set_target_properties(Python3::NumPy PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${OHOS_NUMPY_INCLUDE}")
endif()

set(Python3_FOUND TRUE)
set(Python3_Interpreter_FOUND TRUE)
set(Python3_Development_FOUND TRUE)
set(Python3_Development.Module_FOUND TRUE)
set(Python3_NumPy_FOUND TRUE)
set(Python3_EXECUTABLE "${OHOS_PYTHON_HOST}")
set(Python3_VERSION 3.12.7)
set(Python3_VERSION_MAJOR 3)
set(Python3_VERSION_MINOR 12)
set(Python3_VERSION_PATCH 7)
set(Python3_INCLUDE_DIRS "${OHOS_PYTHON_INCLUDE}")
set(Python3_LIBRARIES "${OHOS_PYTHON_LIBRARY}")
set(Python3_NumPy_INCLUDE_DIRS "${OHOS_NUMPY_INCLUDE}")

function(Python3_add_library name)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "STATIC;SHARED;MODULE;WITH_SOABI" "" "")
    set(kind MODULE)
    foreach(candidate STATIC SHARED)
        if(ARG_${candidate})
            set(kind ${candidate})
        endif()
    endforeach()
    add_library(${name} ${kind} ${ARG_UNPARSED_ARGUMENTS})
    target_link_libraries(${name} PRIVATE Python3::Module)
    if(kind STREQUAL "MODULE")
        set_target_properties(${name} PROPERTIES PREFIX "" SUFFIX ".cpython-312-aarch64-linux-ohos.so")
    endif()
endfunction()
