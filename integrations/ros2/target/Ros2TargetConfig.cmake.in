@PACKAGE_INIT@
if(NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS")
    message(FATAL_ERROR "This installed experimental frontend is OHOS-only")
endif()
set(_fdds_ros2_target_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(fastrtps 2.14.5 EXACT CONFIG)
find_dependency(fastcdr 2 CONFIG)
find_dependency(tinyxml2 CONFIG)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/Ros2TargetTargets.cmake")
set_property(TARGET FastDDSDSoftBusTransportRos2Target::factory_configuration APPEND PROPERTY
    INTERFACE_SOURCES "${_fdds_ros2_target_prefix}/share/FastDDSDSoftBusTransportRos2Target/FactoryAbiProbe.cpp")
if(NOT DEFINED FASTDDS_DSOFTBUS_TOKEN_BRIDGE_LIBRARY OR
        NOT IS_ABSOLUTE "${FASTDDS_DSOFTBUS_TOKEN_BRIDGE_LIBRARY}" OR
        NOT EXISTS "${FASTDDS_DSOFTBUS_TOKEN_BRIDGE_LIBRARY}")
    message(FATAL_ERROR "Declared identity C/POD bridge library is required for this target experiment")
endif()
set_property(TARGET FastDDSDSoftBusTransportRos2Target::factory_configuration APPEND PROPERTY
    INTERFACE_SOURCES
    "${_fdds_ros2_target_prefix}/share/FastDDSDSoftBusTransportRos2Target/IdentityStartup.cpp"
    "${_fdds_ros2_target_prefix}/share/FastDDSDSoftBusTransportRos2Target/identity/token_first_entry.cpp")
set_property(TARGET FastDDSDSoftBusTransportRos2Target::factory_configuration APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "${FASTDDS_DSOFTBUS_TOKEN_BRIDGE_LIBRARY}")
