# The historical profile is an explicit, prefix-bound qualification profile.
# These checks bind CMake inputs, not a runtime attestation of DLL contents.
function(fdds_host_same_path actual expected label)
    if(NOT IS_ABSOLUTE "${actual}" OR NOT EXISTS "${actual}" OR NOT EXISTS "${expected}")
        message(FATAL_ERROR "Host profile ${label}: explicit existing path required")
    endif()
    file(REAL_PATH "${actual}" _actual)
    file(REAL_PATH "${expected}" _expected)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Host profile ${label}: mixed dependency root (${_actual}, expected ${_expected})")
    endif()
endfunction()

# Compile headers/imports stay bound to their package prefix. The original
# deployment may load an identical DLL from its separately declared runtime.
# No search, copy, preloading or runtime tamper protection is performed here.
function(fdds_host_historical_runtime_cdr compile_dll runtime_dll)
    if("${compile_dll}" STREQUAL "" OR "${runtime_dll}" STREQUAL "")
        message(FATAL_ERROR "Historical Host Fast CDR requires explicit existing absolute DLL files")
    endif()
    foreach(_dll IN ITEMS "${compile_dll}" "${runtime_dll}")
        get_filename_component(_extension "${_dll}" LAST_EXT)
        string(TOLOWER "${_extension}" _extension)
        if(NOT IS_ABSOLUTE "${_dll}" OR NOT EXISTS "${_dll}" OR IS_DIRECTORY "${_dll}" OR
           NOT _extension STREQUAL ".dll" OR "${_dll}" MATCHES "[;\r\n]")
            message(FATAL_ERROR "Historical Host Fast CDR requires explicit existing absolute DLL files")
        endif()
    endforeach()
    file(REAL_PATH "${compile_dll}" _compile_path)
    file(REAL_PATH "${runtime_dll}" _runtime_path)
    file(SHA256 "${_compile_path}" _compile_sha)
    file(SHA256 "${_runtime_path}" _runtime_sha)
    if(NOT _compile_sha STREQUAL _runtime_sha)
        message(FATAL_ERROR "Historical Host Fast CDR runtime DLL content differs from compile dependency")
    endif()
    set(_fdds_cdr_compile_path "${_compile_path}" PARENT_SCOPE)
    set(_fdds_cdr_path "${_runtime_path}" PARENT_SCOPE)
    set(_fdds_profile_fastcdr_runtime_sha "${_runtime_sha}" PARENT_SCOPE)
endfunction()

function(fdds_host_historical_dependencies dds_prefix cdr_prefix)
    foreach(_prefix IN ITEMS "${dds_prefix}" "${cdr_prefix}")
        if(NOT IS_ABSOLUTE "${_prefix}" OR NOT IS_DIRECTORY "${_prefix}")
            message(FATAL_ERROR "Historical Host profile requires explicit absolute dependency prefixes")
        endif()
    endforeach()
    fdds_host_same_path("${fastrtps_DIR}" "${dds_prefix}/share/fastrtps/cmake" "Fast DDS package")
    fdds_host_same_path("${fastcdr_DIR}" "${cdr_prefix}/lib/cmake/fastcdr" "Fast CDR package")
    foreach(_target IN ITEMS fastrtps fastcdr)
        if(_target STREQUAL "fastrtps")
            set(_prefix "${dds_prefix}")
            set(_stem fastrtps-2.14)
            set(_header fastrtps/config.h)
        else()
            set(_prefix "${cdr_prefix}")
            set(_stem fastcdr-2.2)
            set(_header fastcdr/config.h)
        endif()
        get_target_property(_type ${_target} TYPE)
        get_target_property(_imported ${_target} IMPORTED)
        if(NOT _imported OR NOT _type STREQUAL "SHARED_LIBRARY")
            message(FATAL_ERROR "Historical Host profile requires imported shared ${_target}")
        endif()
        get_target_property(_includes ${_target} INTERFACE_INCLUDE_DIRECTORIES)
        list(LENGTH _includes _include_count)
        if(NOT _include_count EQUAL 1)
            message(FATAL_ERROR "Historical Host profile requires one declared ${_target} include root")
        endif()
        fdds_host_same_path("${_includes}" "${_prefix}/include" "${_target} headers")
        get_target_property(_implib ${_target} IMPORTED_IMPLIB_RELEASE)
        get_target_property(_dll ${_target} IMPORTED_LOCATION_RELEASE)
        fdds_host_same_path("${_implib}" "${_prefix}/lib/${_stem}.lib" "${_target} import library")
        fdds_host_same_path("${_dll}" "${_prefix}/bin/${_stem}.dll" "${_target} DLL")
        foreach(_kind IN ITEMS header implib dll)
            if(_kind STREQUAL "header")
                set(_file "${_prefix}/include/${_header}")
            else()
                set(_file "${_${_kind}}")
            endif()
            file(SHA256 "${_file}" _sha)
            set(_fdds_profile_${_target}_${_kind}_sha "${_sha}" PARENT_SCOPE)
        endforeach()
    endforeach()
    file(READ "${dds_prefix}/include/fastrtps/config.h" _dds_header)
    file(READ "${cdr_prefix}/include/fastcdr/config.h" _cdr_header)
    foreach(_pair IN ITEMS "MAJOR;2" "MINOR;14" "MICRO;7")
        list(GET _pair 0 _part)
        list(GET _pair 1 _value)
        if(NOT _dds_header MATCHES "#[ \t]*define[ \t]+FASTRTPS_VERSION_${_part}[ \t]+${_value}([ \t\r\n]|$)")
            message(FATAL_ERROR "Historical Host profile requires Fast DDS 2.14.7 headers")
        endif()
    endforeach()
    foreach(_pair IN ITEMS "MAJOR;2" "MINOR;2" "MICRO;8")
        list(GET _pair 0 _part)
        list(GET _pair 1 _value)
        if(NOT _cdr_header MATCHES "#[ \t]*define[ \t]+FASTCDR_VERSION_${_part}[ \t]+${_value}([ \t\r\n]|$)")
            message(FATAL_ERROR "Historical Host profile requires Fast CDR 2.2.8 headers")
        endif()
    endforeach()
    if(NOT _dds_header MATCHES "(^|\n)[ \t]*#[ \t]*define[ \t]+HAVE_SECURITY[ \t]+1([ \t\r\n]|$)" OR
       NOT _dds_header MATCHES "(^|\n)[ \t]*#[ \t]*define[ \t]+FASTDDS_STATISTICS([ \t\r\n]|$)")
        message(FATAL_ERROR "Historical Host profile requires SECURITY ON and STATISTICS ON headers")
    endif()
endfunction()
