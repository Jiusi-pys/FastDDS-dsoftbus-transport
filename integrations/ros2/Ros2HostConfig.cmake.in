@PACKAGE_INIT@
set(_fdds_ros2_package_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(fastrtps @FASTDDS_DSOFTBUS_ROS214_VERSION@ EXACT CONFIG)
find_dependency(fastcdr @FASTDDS_DSOFTBUS_ROS214_CDR_REQUIREMENT@ CONFIG)
find_dependency(Threads)
if(@FASTDDS_DSOFTBUS_ROS214_TEST_ASAN@)
    if(NOT FASTDDS_DSOFTBUS_ROS214_TEST_ASAN)
        message(FATAL_ERROR "This installed package is test-only ASan; an explicit consumer opt-in is required")
    endif()
    set(FASTDDS_DSOFTBUS_ROS214_VERSION "@FASTDDS_DSOFTBUS_ROS214_VERSION@")
    include("${CMAKE_CURRENT_LIST_DIR}/Ros214TestAsan.cmake")
elseif(FASTDDS_DSOFTBUS_ROS214_TEST_ASAN)
    message(FATAL_ERROR "ASan consumer cannot use an uninstrumented Host bridge package")
endif()
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(FastDDSDSoftBusTransportRos2Host_FOUND FALSE)
    set(FastDDSDSoftBusTransportRos2Host_NOT_FOUND_MESSAGE "This package is the explicit Windows Host-only opaque-byte test profile")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Ros2HostTargets.cmake")
set_property(TARGET FastDDSDSoftBusTransportRos2Host::factory_configuration APPEND PROPERTY
    INTERFACE_SOURCES "${_fdds_ros2_package_prefix}/share/FastDDSDSoftBusTransportRos2Host/FactoryAbiProbe.cpp")
check_required_components(FastDDSDSoftBusTransportRos2Host)
