@PACKAGE_INIT@
set(_fdds_ros2_package_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(fastrtps @_fdds_version@ EXACT CONFIG)
find_dependency(fastcdr @_fdds_cdr_version@ @_fdds_cdr_exact@ CONFIG)
find_dependency(Threads)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(FastDDSDSoftBusTransportRos2Host_FOUND FALSE)
    set(FastDDSDSoftBusTransportRos2Host_NOT_FOUND_MESSAGE "This package is the explicit Windows Host-only opaque-byte test profile")
    return()
endif()
set(FastDDSDSoftBusTransportRos2Host_PROFILE "@FASTDDS_DSOFTBUS_HOST_PROFILE@")
set(FastDDSDSoftBusTransportRos2Host_FASTDDS_VERSION "@_fdds_version@")
set(FastDDSDSoftBusTransportRos2Host_FASTCDR_VERSION "@_fdds_cdr_version@")
set(FastDDSDSoftBusTransportRos2Host_HISTORICAL_PREFIX_BOUND @_fdds_historical_profile@)
set(FastDDSDSoftBusTransportRos2Host_FASTCDR_COMPILE_DLL "@_fdds_cdr_compile_path@")
set(FastDDSDSoftBusTransportRos2Host_FASTCDR_COMPILE_DLL_SHA256 "@_fdds_profile_fastcdr_dll_sha@")
set(FastDDSDSoftBusTransportRos2Host_FASTCDR_RUNTIME_DLL "@_fdds_cdr_path@")
set(FastDDSDSoftBusTransportRos2Host_FASTCDR_RUNTIME_DLL_SHA256 "@_fdds_profile_fastcdr_runtime_sha@")
if(@_fdds_historical_profile@)
    string(TOLOWER "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" _fdds_architecture)
    if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR NOT _fdds_architecture STREQUAL "x64" OR
       (CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Release") OR
       (NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE STREQUAL "Release") OR
       (DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL"))
        message(FATAL_ERROR "Historical Host package requires MSVC x64 Release /MD")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/HostProfile.cmake")
    fdds_host_historical_dependencies("@FASTDDS_DSOFTBUS_HISTORICAL_FASTDDS_PREFIX@" "@FASTDDS_DSOFTBUS_HISTORICAL_FASTCDR_PREFIX@")
    fdds_host_historical_runtime_cdr("@_fdds_cdr_compile_path@" "@_fdds_cdr_path@")
    # Explicit snapshots bind installed consumers to this package's inputs.
    set(_expected_fastrtps_header "@_fdds_profile_fastrtps_header_sha@")
    set(_expected_fastrtps_implib "@_fdds_profile_fastrtps_implib_sha@")
    set(_expected_fastrtps_dll "@_fdds_profile_fastrtps_dll_sha@")
    set(_expected_fastcdr_header "@_fdds_profile_fastcdr_header_sha@")
    set(_expected_fastcdr_implib "@_fdds_profile_fastcdr_implib_sha@")
    set(_expected_fastcdr_dll "@_fdds_profile_fastcdr_dll_sha@")
    set(_expected_fastcdr_runtime "@_fdds_profile_fastcdr_runtime_sha@")
    foreach(_anchor IN ITEMS fastrtps_header fastrtps_implib fastrtps_dll fastcdr_header fastcdr_implib fastcdr_dll fastcdr_runtime)
        if(NOT "${_fdds_profile_${_anchor}_sha}" STREQUAL "${_expected_${_anchor}}")
            message(FATAL_ERROR "Historical Host package dependency changed: ${_anchor}")
        endif()
    endforeach()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Ros2HostTargets.cmake")
set_property(TARGET FastDDSDSoftBusTransportRos2Host::factory_configuration APPEND PROPERTY
    INTERFACE_SOURCES "${_fdds_ros2_package_prefix}/share/FastDDSDSoftBusTransportRos2Host/FactoryAbiProbe.cpp")
set_property(TARGET FastDDSDSoftBusTransportRos2Host::factory_configuration APPEND PROPERTY
    INTERFACE_SOURCES "${_fdds_ros2_package_prefix}/share/FastDDSDSoftBusTransportRos2Host/HostProfileProbe.cpp")
check_required_components(FastDDSDSoftBusTransportRos2Host)
