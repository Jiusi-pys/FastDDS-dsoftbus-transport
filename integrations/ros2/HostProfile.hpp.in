#pragma once
#include <fastrtps/config.h>
#include <fastcdr/config.h>

#define FASTDDS_DSOFTBUS_HOST_HISTORICAL_PROFILE @_fdds_historical_profile@
static_assert(FASTRTPS_VERSION_MAJOR == 2 && FASTRTPS_VERSION_MINOR == 14 &&
        FASTRTPS_VERSION_MICRO == @_fdds_micro@, "Host profile Fast DDS headers mismatch");
#if FASTDDS_DSOFTBUS_HOST_HISTORICAL_PROFILE
#if !defined(_MSC_VER) || !defined(_M_X64) || !defined(_DLL) || defined(_DEBUG)
#error Historical Host profile requires MSVC x64 Release DLL CRT
#endif
static_assert(HAVE_SECURITY == 1, "Historical Host profile requires SECURITY ON");
#ifndef FASTDDS_STATISTICS
#error Historical Host profile requires STATISTICS ON
#endif
static_assert(FASTCDR_VERSION_MAJOR == 2 && FASTCDR_VERSION_MINOR == 2 &&
        FASTCDR_VERSION_MICRO == 8, "Historical Host profile requires Fast CDR 2.2.8");
#endif
namespace fastdds_dsoftbus::ros2_host_profile {
inline constexpr const char* name = "@FASTDDS_DSOFTBUS_HOST_PROFILE@";
// Historical only: intentional dependency-prefix binding. This is not a hash
// check and cannot detect replacement of a DLL at the same path during a run.
inline constexpr const char* factory_path = R"fdds(@_fdds_factory_path@)fdds";
inline constexpr const char* cdr_compile_path = R"fdds(@_fdds_cdr_compile_path@)fdds";
inline constexpr const char* cdr_compile_sha256 = "@_fdds_profile_fastcdr_dll_sha@";
inline constexpr const char* cdr_path = R"fdds(@_fdds_cdr_path@)fdds";
inline constexpr const char* cdr_runtime_sha256 = "@_fdds_profile_fastcdr_runtime_sha@";
}
