+// A1 opt-in: process-wide, sampled once. Never enable in a shared launcher
+// unless every reader in that process is intended to honour its policy.
+static bool honor_type_consistency()
+{
+    static const bool enabled = []()
+            {
+#ifdef _MSC_VER
+                char* value = nullptr;
+                size_t length = 0;
+                const bool gate_set = _dupenv_s(&value, &length,
+                                "FASTDDS_XTYPES_HONOR_TYPE_CONSISTENCY") == 0 &&
+                        value != nullptr && std::strcmp(value, "1") == 0;
+                std::free(value);
+                return gate_set;
+#else
+                const char* value = std::getenv("FASTDDS_XTYPES_HONOR_TYPE_CONSISTENCY");
+                return value != nullptr && std::strcmp(value, "1") == 0;
+#endif
+            }();
+    return enabled;
+}
