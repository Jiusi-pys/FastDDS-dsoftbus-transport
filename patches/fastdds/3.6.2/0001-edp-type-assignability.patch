+namespace {
+using namespace dds::xtypes;
+using type_assignability::struct_assignable;
+
+bool assignable_type_information(
+        const TypeInformation& reader,
+        const TypeInformation& writer,
+        const dds::TypeConsistencyEnforcementQosPolicy& policy)
+{
+    if (policy.m_kind != dds::ALLOW_TYPE_COERCION)
+    {
+        return false; // Equivalence is checked by the caller first.
+    }
+    auto& registry = RTPSDomainImpl::get_instance()->type_object_registry();
+    TypeObject r, w;
+    // TypeLookup finishes before EDP pairing. Read owned copies from the
+    // thread-safe registry; do not issue requests or retain registry locks.
+    if (dds::RETCODE_OK == registry.get_type_object(reader.complete().typeid_with_size().type_id(), r) &&
+            dds::RETCODE_OK == registry.get_type_object(writer.complete().typeid_with_size().type_id(), w))
+    {
+        return r._d() == EK_COMPLETE && w._d() == EK_COMPLETE &&
+               r.complete()._d() == TK_STRUCTURE && w.complete()._d() == TK_STRUCTURE &&
+               struct_assignable(r.complete().struct_type(), w.complete().struct_type(), policy);
+    }
+    if (dds::RETCODE_OK == registry.get_type_object(reader.minimal().typeid_with_size().type_id(), r) &&
+            dds::RETCODE_OK == registry.get_type_object(writer.minimal().typeid_with_size().type_id(), w))
+    {
+        return r._d() == EK_MINIMAL && w._d() == EK_MINIMAL &&
+               r.minimal()._d() == TK_STRUCTURE && w.minimal()._d() == TK_STRUCTURE &&
+               struct_assignable(r.minimal().struct_type(), w.minimal().struct_type(), policy);
+    }
+    return false;
+}
