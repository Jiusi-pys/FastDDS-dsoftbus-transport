+// A1 bounded XTypes assignability, shared by EDP and contract tests.
+#ifndef RTPS_BUILTIN_DISCOVERY_ENDPOINT_TYPE_ASSIGNABILITY_HPP
+#define RTPS_BUILTIN_DISCOVERY_ENDPOINT_TYPE_ASSIGNABILITY_HPP
+#include <fastdds/dds/core/policy/QosPolicies.hpp>
+#include <fastdds/dds/xtypes/type_representation/TypeObject.hpp>
+namespace eprosima { namespace fastdds { namespace rtps {
+namespace type_assignability {
+using namespace dds::xtypes;
+
+inline const MemberName& member_name(const CompleteStructMember& member)
+{
+    return member.detail().name();
+}
+
+inline const NameHash& member_name(const MinimalStructMember& member)
+{
+    return member.detail().name_hash();
+}
+
+// The A1 coercion subset is flat structs with equivalent member types or
+// bounded strings. Other non-equivalent member types fail closed; this is
+// deliberately not a claim of the full XTypes assignability algorithm.
+inline bool member_type_assignable(
+        const TypeIdentifier& reader,
+        const TypeIdentifier& writer,
+        const dds::TypeConsistencyEnforcementQosPolicy& policy,
+        bool key)
+{
+    if (reader == writer)
+    {
+        return true;
+    }
+    if (reader._d() != writer._d())
+    {
+        return false;
+    }
+    const bool ignore_bounds = policy.m_ignore_string_bounds && !key;
+    switch (reader._d())
+    {
+        case TI_STRING8_SMALL:
+        case TI_STRING16_SMALL:
+            return ignore_bounds || reader.string_sdefn().bound() == 0 ||
+                   (writer.string_sdefn().bound() != 0 &&
+                   reader.string_sdefn().bound() >= writer.string_sdefn().bound());
+        case TI_STRING8_LARGE:
+        case TI_STRING16_LARGE:
+            return ignore_bounds || reader.string_ldefn().bound() == 0 ||
+                   (writer.string_ldefn().bound() != 0 &&
+                   reader.string_ldefn().bound() >= writer.string_ldefn().bound());
+        default:
+            return false;
+    }
+}
+
+template<typename Struct>
+bool struct_assignable(
+        const Struct& reader,
+        const Struct& writer,
+        const dds::TypeConsistencyEnforcementQosPolicy& policy)
+{
+    const auto extent_mask = IS_FINAL | IS_APPENDABLE | IS_MUTABLE;
+    const auto extent = reader.struct_flags() & extent_mask;
+    if (extent != (writer.struct_flags() & extent_mask) ||
+            (extent != IS_FINAL && extent != IS_APPENDABLE && extent != IS_MUTABLE) ||
+            reader.header().base_type()._d() != TK_NONE || writer.header().base_type()._d() != TK_NONE)
+    {
+        return false;
+    }
+    const auto& rm = reader.member_seq();
+    const auto& wm = writer.member_seq();
+    // Bound the quadratic name/ID checks performed on untrusted remote types.
+    if (rm.empty() || wm.empty() || rm.size() > 256 || wm.size() > 256 ||
+            (extent == IS_FINAL && rm.size() != wm.size()))
+    {
+        return false;
+    }
+    bool common = false;
+    for (size_t i = 0; i < rm.size(); ++i)
+    {
+        const auto& r = rm[i];
+        const auto rf = r.common().member_flags();
+        bool found = false;
+        for (size_t j = 0; j < wm.size(); ++j)
+        {
+            const auto& w = wm[j];
+            const bool same_id = r.common().member_id() == w.common().member_id();
+            if (!policy.m_ignore_member_names && (same_id != (member_name(r) == member_name(w))))
+            {
+                return false;
+            }
+            if (!same_id)
+            {
+                continue;
+            }
+            const auto wf = w.common().member_flags();
+            if ((extent != IS_MUTABLE && i != j) ||
+                    ((rf ^ wf) & (IS_KEY | IS_OPTIONAL)) != 0 ||
+                    !member_type_assignable(r.common().member_type_id(), w.common().member_type_id(),
+                    policy, ((rf | wf) & IS_KEY) != 0))
+            {
+                return false;
+            }
+            found = common = true;
+        }
+        if (!found && (((rf & IS_KEY) != 0) ||
+                ((rf & IS_MUST_UNDERSTAND) != 0 && (rf & IS_OPTIONAL) == 0) ||
+                (extent != IS_MUTABLE && i < wm.size())))
+        {
+            return false;
+        }
+    }
+    for (size_t j = 0; j < wm.size(); ++j)
+    {
+        const auto& w = wm[j];
+        const auto wf = w.common().member_flags();
+        bool found = false;
+        for (const auto& r : rm)
+        {
+            found = found || r.common().member_id() == w.common().member_id();
+        }
+        if (!found && ((policy.m_prevent_type_widening && (wf & IS_OPTIONAL) == 0) || (wf & IS_KEY) != 0 ||
+                ((wf & IS_MUST_UNDERSTAND) != 0 && (wf & IS_OPTIONAL) == 0) ||
+                (extent != IS_MUTABLE && j < rm.size())))
+        {
+            return false;
+        }
+    }
+    return common;
+}
+
+} // namespace type_assignability
+}}}
+#endif
