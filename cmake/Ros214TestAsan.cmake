# Explicit Host test profile. The production Ros214Candidate guards remain unchanged.
option(FASTDDS_DSOFTBUS_ROS214_TEST_ASAN "Test-only secure ROS address sanitizer profile" OFF)
if(FASTDDS_DSOFTBUS_ROS214_TEST_ASAN)
    if(NOT WIN32 OR NOT MSVC OR CMAKE_CROSSCOMPILING OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "ROS214 test ASan requires native MSVC x64")
    endif()
    if(NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
        message(FATAL_ERROR "ROS214 test ASan requires explicit Release DLL CRT /MD")
    endif()
    if(CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Release")
        message(FATAL_ERROR "ROS214 test ASan requires Release-only shared imports; no Debug/RelWith mapping")
    endif()
    if(CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL "Release")
        message(FATAL_ERROR "ROS214 test ASan requires Release")
    endif()
    if(NOT FASTDDS_DSOFTBUS_ROS214_VERSION STREQUAL "2.14.7")
        message(FATAL_ERROR "ROS214 test ASan is bound to the explicit 2.14.7 candidate")
    endif()
    file(REAL_PATH "${fastrtps_DIR}/../../.." _asan_dds_prefix)
    file(READ "${_asan_dds_prefix}/include/fastrtps/config.h" _asan_dds_config)
    if(NOT _asan_dds_config MATCHES "#define HAVE_SECURITY 1")
        message(FATAL_ERROR "ROS214 test ASan requires SECURITY=ON; plugins may be disabled only by an explicit development control")
    endif()
    # The Visual Studio generator used here does not populate CMAKE_DUMPBIN, so
    # derive it from the selected compiler instead of requiring a magic CLI
    # variable. The tool must still exist; this is a lookup, not a waiver.
    if(NOT CMAKE_DUMPBIN OR NOT EXISTS "${CMAKE_DUMPBIN}")
        get_filename_component(_asan_toolchain_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
        find_program(_asan_dumpbin NAMES dumpbin dumpbin.exe HINTS "${_asan_toolchain_dir}" NO_DEFAULT_PATH)
        if(NOT _asan_dumpbin)
            message(FATAL_ERROR "ROS214 test ASan could not locate the selected MSVC dumpbin next to ${CMAKE_CXX_COMPILER}")
        endif()
        set(CMAKE_DUMPBIN "${_asan_dumpbin}")
    endif()
    foreach(_dependency fastrtps fastcdr)
        get_target_property(_asan_type ${_dependency} TYPE)
        get_target_property(_asan_binary ${_dependency} IMPORTED_LOCATION_RELEASE)
        if(NOT _asan_type STREQUAL "SHARED_LIBRARY" OR NOT EXISTS "${_asan_binary}")
            message(FATAL_ERROR "ROS214 test ASan requires actual RELEASE shared ${_dependency}")
        endif()
        execute_process(COMMAND "${CMAKE_DUMPBIN}" /imports "${_asan_binary}"
            RESULT_VARIABLE _asan_import_status OUTPUT_VARIABLE _asan_imports ERROR_VARIABLE _asan_import_errors)
        if(NOT _asan_import_status EQUAL 0 OR NOT _asan_imports MATCHES "clang_rt[.]asan_dynamic-x86_64[.]dll")
            message(FATAL_ERROR "ROS214 test ASan dependency is not instrumented: ${_dependency}: ${_asan_import_errors}")
        endif()
    endforeach()
endif()

function(fastdds_dsoftbus_test_asan_target target_name)
    if(FASTDDS_DSOFTBUS_ROS214_TEST_ASAN)
        target_compile_options(${target_name} PRIVATE /fsanitize=address /Zi /Oy-)
        target_link_options(${target_name} PRIVATE /INCREMENTAL:NO /DEBUG)
        target_compile_definitions(${target_name} PRIVATE FASTDDS_DSOFTBUS_TEST_ONLY_ASAN=1)
    endif()
endfunction()
