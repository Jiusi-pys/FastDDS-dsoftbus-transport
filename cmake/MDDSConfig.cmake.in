@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
get_property(_mdds_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(_mdds_multi)
    string(TOUPPER "${CMAKE_CONFIGURATION_TYPES}" _mdds_configs)
else()
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _mdds_configs)
endif()
if(NOT _mdds_configs STREQUAL "RELEASE")
    message(FATAL_ERROR "MDDS installed package supports matching Release CONFIG dependencies only")
endif()
if(MSVC AND ("${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_RELEASE}" MATCHES "(^|[ ;])[-/](MTd?|MDd)([ ;]|$)" OR
        (DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL" AND
        NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")))
    message(FATAL_ERROR "MDDS requires the matching Release DLL CRT")
endif()
find_dependency(Threads)
get_property(_mdds_imports_before DIRECTORY PROPERTY IMPORTED_TARGETS)
find_dependency(fastdds 3.6.2.0 EXACT CONFIG COMPONENTS shared)
if(NOT TARGET fastdds OR NOT TARGET fastcdr OR NOT TARGET foonathan_memory)
    set(MDDS_FOUND FALSE)
    set(MDDS_NOT_FOUND_MESSAGE "MDDS requires the matching shared Fast DDS/Fast CDR/foonathan CONFIG installation")
    return()
endif()
# Preserve the same imported-target, prefix and Release contract as FastddsBinding.cmake.
get_property(_mdds_local_imports DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_mdds_import IN LISTS _mdds_local_imports)
    if(NOT _mdds_import IN_LIST _mdds_imports_before)
        set_property(TARGET "${_mdds_import}" PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
endforeach()
file(REAL_PATH "${fastdds_DIR}/fastdds-config.cmake" _mdds_requested_config)
file(REAL_PATH "${fastdds_CONFIG}" _mdds_selected_config)
if(NOT _mdds_selected_config STREQUAL _mdds_requested_config)
    message(FATAL_ERROR "MDDS selected a different Fast DDS CONFIG package")
endif()
file(REAL_PATH "${fastdds_DIR}/../../.." _mdds_prefix)
# A parent's pre-existing target can survive an export file's early return.
# Validate the actual target, not merely find_package's version result.
foreach(_mdds_dependency IN ITEMS fastdds fastcdr foonathan_memory)
    if(NOT TARGET "${_mdds_dependency}")
        message(FATAL_ERROR "CONFIG is missing imported dependency ${_mdds_dependency}")
    endif()
    get_target_property(_mdds_imported "${_mdds_dependency}" IMPORTED)
    get_target_property(_mdds_global "${_mdds_dependency}" IMPORTED_GLOBAL)
    get_target_property(_mdds_type "${_mdds_dependency}" TYPE)
    get_target_property(_mdds_configs "${_mdds_dependency}" IMPORTED_CONFIGURATIONS)
    if(NOT _mdds_imported OR NOT _mdds_type STREQUAL "SHARED_LIBRARY" OR
            NOT "RELEASE" IN_LIST _mdds_configs)
        message(FATAL_ERROR "CONFIG requires an actual shared RELEASE import for ${_mdds_dependency}")
    endif()
    if(NOT _mdds_global)
        message(FATAL_ERROR "CONFIG requires GLOBAL imported dependency ${_mdds_dependency}; the directory that created a preloaded import must promote it before adding this project")
    endif()
    # Even an explicitly empty mapping can select a configuration-less artifact
    # instead of the RELEASE file checked below. Never silently rewrite it.
    get_property(_mdds_mapping_set TARGET "${_mdds_dependency}" PROPERTY MAP_IMPORTED_CONFIG_RELEASE SET)
    if(_mdds_mapping_set)
        get_target_property(_mdds_mapping "${_mdds_dependency}" MAP_IMPORTED_CONFIG_RELEASE)
        string(TOUPPER "${_mdds_mapping}" _mdds_mapping)
        if(NOT _mdds_mapping STREQUAL "RELEASE")
            message(FATAL_ERROR "CONFIG requires unset or single RELEASE mapping for ${_mdds_dependency}; MAP_IMPORTED_CONFIG_RELEASE cannot select another or configuration-less artifact")
        endif()
    endif()
    set(_mdds_artifact_properties IMPORTED_LOCATION_RELEASE)
    if(WIN32)
        list(APPEND _mdds_artifact_properties IMPORTED_IMPLIB_RELEASE)
    endif()
    foreach(_mdds_property IN LISTS _mdds_artifact_properties)
        get_target_property(_mdds_artifact "${_mdds_dependency}" "${_mdds_property}")
        if(NOT IS_ABSOLUTE "${_mdds_artifact}" OR NOT EXISTS "${_mdds_artifact}")
            message(FATAL_ERROR "CONFIG ${_mdds_dependency} lacks existing ${_mdds_property}")
        endif()
        file(REAL_PATH "${_mdds_artifact}" _mdds_real_artifact)
        if(_mdds_dependency STREQUAL "fastdds")
            cmake_path(IS_PREFIX _mdds_prefix "${_mdds_real_artifact}" NORMALIZE _mdds_inside)
            if(NOT _mdds_inside)
                message(FATAL_ERROR "CONFIG conflicting fastdds import outside selected prefix: ${_mdds_real_artifact}")
            endif()
        endif()
        message(STATUS "MDDS CONFIG ${_mdds_dependency} ${_mdds_property}: ${_mdds_real_artifact}")
    endforeach()
endforeach()
get_target_property(_mdds_includes fastdds INTERFACE_INCLUDE_DIRECTORIES)
file(REAL_PATH "${_mdds_prefix}/include" _mdds_expected_include)
if(NOT _mdds_includes)
    message(FATAL_ERROR "CONFIG fastdds has no installed include directory")
endif()
foreach(_mdds_include IN LISTS _mdds_includes)
    if(NOT IS_ABSOLUTE "${_mdds_include}")
        message(FATAL_ERROR "CONFIG conflicting fastdds include: ${_mdds_include}")
    endif()
    file(REAL_PATH "${_mdds_include}" _mdds_real_include)
    if(NOT _mdds_real_include STREQUAL _mdds_expected_include)
        message(FATAL_ERROR "CONFIG conflicting fastdds include outside selected installation: ${_mdds_include}")
    endif()
endforeach()
if(NOT EXISTS "${_mdds_expected_include}/fastdds/config.hpp")
    message(FATAL_ERROR "CONFIG is missing its actual installed fastdds/config.hpp")
endif()

if("Experimental" IN_LIST MDDS_FIND_COMPONENTS)
    if(NOT @MDDS_HAS_EXPERIMENTAL@)
        set(MDDS_FOUND FALSE)
        set(MDDS_NOT_FOUND_MESSAGE "This MDDS installation does not contain the real isolated experimental runtime")
        return()
    endif()
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR NOT IS_ABSOLUTE "${MDDS_SOCKET_LIBRARY}" OR NOT EXISTS "${MDDS_SOCKET_LIBRARY}")
        set(MDDS_FOUND FALSE)
        set(MDDS_NOT_FOUND_MESSAGE "Experimental needs OHOS and explicit MDDS_SOCKET_LIBRARY (declared target platform DSO)")
        return()
    endif()
    if(NOT TARGET mdds_public_socket_api)
        add_library(mdds_public_socket_api SHARED IMPORTED)
        set_target_properties(mdds_public_socket_api PROPERTIES IMPORTED_LOCATION "${MDDS_SOCKET_LIBRARY}")
    else()
        get_target_property(_socket_location mdds_public_socket_api IMPORTED_LOCATION)
        get_target_property(_socket_type mdds_public_socket_api TYPE)
        if(NOT _socket_location STREQUAL MDDS_SOCKET_LIBRARY OR NOT _socket_type STREQUAL "SHARED_LIBRARY")
            message(FATAL_ERROR "MDDS Socket target conflicts with explicit platform library")
        endif()
    endif()
    set(MDDS_Experimental_FOUND TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MDDSTargets.cmake")
if("Experimental" IN_LIST MDDS_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/MDDSExperimentalTargets.cmake")
endif()
check_required_components(MDDS)
