# One selected header/binary configuration throughout the project target closure.
# Called only when a target actually needs Fast DDS.
add_library(fastdds_dsoftbus_fastdds_binding INTERFACE)
target_compile_definitions(fastdds_dsoftbus_fastdds_binding INTERFACE FASTDDS_NO_LIB)

if(FASTDDS_DSOFTBUS_FASTDDS_MODE STREQUAL "SOURCE_PROBE")
    include("${CMAKE_CURRENT_LIST_DIR}/ProbeFastddsConfig.cmake")
    target_include_directories(fastdds_dsoftbus_fastdds_binding INTERFACE
        "${CMAKE_CURRENT_BINARY_DIR}/generated" "${FASTDDS_SOURCE_DIR}/include")
    return()
endif()

if(NOT IS_ABSOLUTE "${fastdds_DIR}" OR
        NOT EXISTS "${fastdds_DIR}/fastdds-config.cmake" OR
        NOT EXISTS "${fastdds_DIR}/fastdds-config-version.cmake")
    message(FATAL_ERROR "CONFIG requires an explicit absolute fastdds_DIR with the installed CONFIG package")
endif()
get_property(_fastdds_dsoftbus_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(_fastdds_dsoftbus_multi)
    string(TOUPPER "${CMAKE_CONFIGURATION_TYPES}" _fastdds_dsoftbus_configurations)
else()
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _fastdds_dsoftbus_configurations)
endif()
if(NOT _fastdds_dsoftbus_configurations STREQUAL "RELEASE")
    message(FATAL_ERROR "CONFIG currently requires Release only: set CMAKE_BUILD_TYPE=Release or CMAKE_CONFIGURATION_TYPES=Release; Debug-to-Release ABI mapping is unsupported")
endif()
if(MSVC)
    if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND
            NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL" AND
            NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
        message(FATAL_ERROR "CONFIG requires the matching MSVC Release DLL CRT (/MD)")
    endif()
    # Do not let explicit driver flags defeat the checked release CRT choice.
    if("${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_RELEASE}" MATCHES "(^|[ ;])[-/](MTd?|MDd)([ ;]|$)")
        message(FATAL_ERROR "CONFIG compiler flags request an incompatible MSVC CRT; /MD is required")
    endif()
endif()

file(REAL_PATH "${fastdds_DIR}/fastdds-config.cmake" _fastdds_dsoftbus_requested_config)
file(REAL_PATH "${fastdds_DIR}/../../.." _fastdds_dsoftbus_prefix)
get_property(_fastdds_dsoftbus_imports_before DIRECTORY PROPERTY IMPORTED_TARGETS)
find_package(fastdds 3.6.2.0 EXACT CONFIG REQUIRED COMPONENTS shared
    PATHS "${fastdds_DIR}" NO_DEFAULT_PATH)
# Upstream's public DYN_LINK expression uses TARGET_EXISTS:fastdds at consumer
# evaluation time. Directory-local imports can therefore silently lose the DLL
# annotation in an add_subdirectory parent. Promote only imports owned by this
# directory (CMake forbids promoting an import created in a different directory).
get_property(_fastdds_dsoftbus_local_imports DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_fastdds_dsoftbus_import IN LISTS _fastdds_dsoftbus_local_imports)
    if(NOT _fastdds_dsoftbus_import IN_LIST _fastdds_dsoftbus_imports_before)
        set_property(TARGET "${_fastdds_dsoftbus_import}" PROPERTY IMPORTED_GLOBAL TRUE)
    endif()
endforeach()
file(REAL_PATH "${fastdds_CONFIG}" _fastdds_dsoftbus_selected_config)
if(NOT _fastdds_dsoftbus_selected_config STREQUAL _fastdds_dsoftbus_requested_config)
    message(FATAL_ERROR "CONFIG selected a different fastdds package than the explicit fastdds_DIR")
endif()

# A parent's pre-existing target can survive an export file's early return.
# Validate the actual target, not merely find_package's version result.
foreach(_fastdds_dsoftbus_dependency IN ITEMS fastdds fastcdr foonathan_memory)
    if(NOT TARGET "${_fastdds_dsoftbus_dependency}")
        message(FATAL_ERROR "CONFIG is missing imported dependency ${_fastdds_dsoftbus_dependency}")
    endif()
    get_target_property(_fastdds_dsoftbus_imported "${_fastdds_dsoftbus_dependency}" IMPORTED)
    get_target_property(_fastdds_dsoftbus_global "${_fastdds_dsoftbus_dependency}" IMPORTED_GLOBAL)
    get_target_property(_fastdds_dsoftbus_type "${_fastdds_dsoftbus_dependency}" TYPE)
    get_target_property(_fastdds_dsoftbus_configs "${_fastdds_dsoftbus_dependency}" IMPORTED_CONFIGURATIONS)
    if(NOT _fastdds_dsoftbus_imported OR NOT _fastdds_dsoftbus_type STREQUAL "SHARED_LIBRARY" OR
            NOT "RELEASE" IN_LIST _fastdds_dsoftbus_configs)
        message(FATAL_ERROR "CONFIG requires an actual shared RELEASE import for ${_fastdds_dsoftbus_dependency}")
    endif()
    if(NOT _fastdds_dsoftbus_global)
        message(FATAL_ERROR "CONFIG requires GLOBAL imported dependency ${_fastdds_dsoftbus_dependency}; the directory that created a preloaded import must promote it before adding this project")
    endif()
    # Even an explicitly empty mapping can select a configuration-less artifact
    # instead of the RELEASE file checked below. Never silently rewrite it.
    get_property(_fastdds_dsoftbus_mapping_set TARGET "${_fastdds_dsoftbus_dependency}" PROPERTY MAP_IMPORTED_CONFIG_RELEASE SET)
    if(_fastdds_dsoftbus_mapping_set)
        get_target_property(_fastdds_dsoftbus_mapping "${_fastdds_dsoftbus_dependency}" MAP_IMPORTED_CONFIG_RELEASE)
        string(TOUPPER "${_fastdds_dsoftbus_mapping}" _fastdds_dsoftbus_mapping)
        if(NOT _fastdds_dsoftbus_mapping STREQUAL "RELEASE")
            message(FATAL_ERROR "CONFIG requires unset or single RELEASE mapping for ${_fastdds_dsoftbus_dependency}; MAP_IMPORTED_CONFIG_RELEASE cannot select another or configuration-less artifact")
        endif()
    endif()
    set(_fastdds_dsoftbus_artifact_properties IMPORTED_LOCATION_RELEASE)
    if(WIN32)
        list(APPEND _fastdds_dsoftbus_artifact_properties IMPORTED_IMPLIB_RELEASE)
    endif()
    foreach(_fastdds_dsoftbus_property IN LISTS _fastdds_dsoftbus_artifact_properties)
        get_target_property(_fastdds_dsoftbus_artifact "${_fastdds_dsoftbus_dependency}" "${_fastdds_dsoftbus_property}")
        if(NOT IS_ABSOLUTE "${_fastdds_dsoftbus_artifact}" OR NOT EXISTS "${_fastdds_dsoftbus_artifact}")
            message(FATAL_ERROR "CONFIG ${_fastdds_dsoftbus_dependency} lacks existing ${_fastdds_dsoftbus_property}")
        endif()
        file(REAL_PATH "${_fastdds_dsoftbus_artifact}" _fastdds_dsoftbus_real_artifact)
        if(_fastdds_dsoftbus_dependency STREQUAL "fastdds")
            cmake_path(IS_PREFIX _fastdds_dsoftbus_prefix "${_fastdds_dsoftbus_real_artifact}" NORMALIZE _fastdds_dsoftbus_inside)
            if(NOT _fastdds_dsoftbus_inside)
                message(FATAL_ERROR "CONFIG conflicting fastdds import outside selected prefix: ${_fastdds_dsoftbus_real_artifact}")
            endif()
        endif()
        message(STATUS "Fast DDS OpenHarmony DSoftBus Transport CONFIG ${_fastdds_dsoftbus_dependency} ${_fastdds_dsoftbus_property}: ${_fastdds_dsoftbus_real_artifact}")
    endforeach()
endforeach()
get_target_property(_fastdds_dsoftbus_includes fastdds INTERFACE_INCLUDE_DIRECTORIES)
file(REAL_PATH "${_fastdds_dsoftbus_prefix}/include" _fastdds_dsoftbus_expected_include)
if(NOT _fastdds_dsoftbus_includes)
    message(FATAL_ERROR "CONFIG fastdds has no installed include directory")
endif()
foreach(_fastdds_dsoftbus_include IN LISTS _fastdds_dsoftbus_includes)
    if(NOT IS_ABSOLUTE "${_fastdds_dsoftbus_include}")
        message(FATAL_ERROR "CONFIG conflicting fastdds include: ${_fastdds_dsoftbus_include}")
    endif()
    file(REAL_PATH "${_fastdds_dsoftbus_include}" _fastdds_dsoftbus_real_include)
    if(NOT _fastdds_dsoftbus_real_include STREQUAL _fastdds_dsoftbus_expected_include)
        message(FATAL_ERROR "CONFIG conflicting fastdds include outside selected installation: ${_fastdds_dsoftbus_include}")
    endif()
endforeach()
if(NOT EXISTS "${_fastdds_dsoftbus_expected_include}/fastdds/config.hpp")
    message(FATAL_ERROR "CONFIG is missing its actual installed fastdds/config.hpp")
endif()

target_link_libraries(fastdds_dsoftbus_fastdds_binding INTERFACE fastdds)
if(MSVC)
    target_compile_options(fastdds_dsoftbus_fastdds_binding INTERFACE $<$<COMPILE_LANGUAGE:CXX>:/utf-8>)
endif()
message(STATUS "Fast DDS OpenHarmony DSoftBus Transport Fast DDS binding: CONFIG ${_fastdds_dsoftbus_selected_config}, Release shared")
