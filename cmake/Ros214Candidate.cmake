# Explicit maintenance selection; the legacy installed/source defaults stay pinned.
set(FASTDDS_DSOFTBUS_ROS214_VERSION "2.14.5" CACHE STRING "Exact ROS214 release (2.14.5 legacy or 2.14.7 candidate)")
if(NOT FASTDDS_DSOFTBUS_ROS214_VERSION MATCHES "^2\\.14\\.(5|7)$")
    message(FATAL_ERROR "Unsupported version-bound ROS214 candidate")
endif()
string(REGEX REPLACE "^2\\.14\\." "" FASTDDS_DSOFTBUS_ROS214_PATCH "${FASTDDS_DSOFTBUS_ROS214_VERSION}")
find_package(fastrtps ${FASTDDS_DSOFTBUS_ROS214_VERSION} EXACT CONFIG REQUIRED)
if(FASTDDS_DSOFTBUS_ROS214_VERSION STREQUAL "2.14.7")
    find_package(fastcdr 2.2.8 EXACT CONFIG REQUIRED)
    set(FASTDDS_DSOFTBUS_ROS214_CDR_REQUIREMENT "2.2.8 EXACT")
    set(FASTDDS_DSOFTBUS_ROS214_CANDIDATE_JSON "{\"version\":\"2.14.7\",\"upstream_commit\":\"010b908dc3bb2b6f2818d61ac8db462d01b79a1f\",\"fastcdr_version\":\"2.2.8\",\"fastcdr_commit\":\"1bc9c919311ffce555b445560bf7ae062a4e1c72\",\"interface_abi\":21405}")
else()
    find_package(fastcdr 2 CONFIG REQUIRED)
    set(FASTDDS_DSOFTBUS_ROS214_CDR_REQUIREMENT "2")
    set(FASTDDS_DSOFTBUS_ROS214_CANDIDATE_JSON "null")
endif()
file(REAL_PATH "${fastrtps_DIR}/../../.." _ros214_prefix)
get_target_property(_ros214_file fastrtps IMPORTED_LOCATION_RELEASE)
get_target_property(_ros214_includes fastrtps INTERFACE_INCLUDE_DIRECTORIES)
if(NOT IS_ABSOLUTE "${_ros214_file}" OR NOT EXISTS "${_ros214_file}")
    message(FATAL_ERROR "ROS214 requires the actual selected RELEASE shared binary")
endif()
file(REAL_PATH "${_ros214_file}" _ros214_real_file)
cmake_path(IS_PREFIX _ros214_prefix "${_ros214_real_file}" NORMALIZE _ros214_inside)
if(NOT _ros214_inside)
    message(FATAL_ERROR "ROS214 foreign imported binary outside selected candidate prefix")
endif()
foreach(_inc IN LISTS _ros214_includes)
    file(REAL_PATH "${_inc}" _inc_real)
    if(NOT _inc_real STREQUAL "${_ros214_prefix}/include")
        message(FATAL_ERROR "ROS214 foreign installed header prefix")
    endif()
endforeach()
file(READ "${_ros214_prefix}/include/fastrtps/config.h" _ros214_config)
if(NOT _ros214_config MATCHES "#define FASTRTPS_VERSION_STR \"${FASTDDS_DSOFTBUS_ROS214_VERSION}\"")
    message(FATAL_ERROR "ROS214 configured header release mismatch")
endif()
if(FASTDDS_DSOFTBUS_ROS214_VERSION STREQUAL "2.14.7")
    file(REAL_PATH "${fastcdr_DIR}/../../.." _ros214_cdr_prefix)
    get_target_property(_cdr_file fastcdr IMPORTED_LOCATION_RELEASE)
    get_target_property(_cdr_includes fastcdr INTERFACE_INCLUDE_DIRECTORIES)
    if(NOT IS_ABSOLUTE "${_cdr_file}" OR NOT EXISTS "${_cdr_file}")
        message(FATAL_ERROR "Candidate requires actual RELEASE Fast CDR import")
    endif()
    file(REAL_PATH "${_cdr_file}" _cdr_real)
    cmake_path(IS_PREFIX _ros214_cdr_prefix "${_cdr_real}" NORMALIZE _cdr_inside)
    if(NOT _cdr_inside)
        message(FATAL_ERROR "Candidate foreign Fast CDR binary prefix")
    endif()
    foreach(_inc IN LISTS _cdr_includes)
        file(REAL_PATH "${_inc}" _cdr_inc)
        if(NOT _cdr_inc STREQUAL "${_ros214_cdr_prefix}/include")
            message(FATAL_ERROR "Candidate foreign Fast CDR header prefix")
        endif()
    endforeach()
endif()
