# Add the same offline checker to each existing ABI-specific delivery. No dependency
# download, SDK discovery, private artifact installation or production registration.
function(fastdds_dsoftbus_install_preflight package experimental)
    cmake_parse_arguments(PF "" "" "DEPENDENCIES;TARGETS" ${ARGN})
    if(CMAKE_SYSTEM_NAME STREQUAL "OHOS")
        set(_architecture "${CMAKE_SYSTEM_PROCESSOR}")
        if(OHOS_ARCH STREQUAL "arm64-v8a")
            set(_architecture aarch64)
        endif()
        # OHOS_PLATFORM_LEVEL is an internal toolchain level (often 1), not SDK API.
        file(READ "${OHOS_SDK_NATIVE}/oh-uni-package.json" _sdk_package)
        string(JSON _sdk_api GET "${_sdk_package}" apiVersion)
        string(JSON _sdk_version GET "${_sdk_package}" version)
        set(_stl "${OHOS_STL}")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_NAME STREQUAL "Windows")
        set(_architecture x86_64)
        set(_sdk_api "N/A")
        set(_sdk_version "N/A")
        set(_stl "MSVC_MD")
    else()
        set(_architecture "${CMAKE_SYSTEM_PROCESSOR}")
        set(_sdk_api "N/A")
        set(_sdk_version "N/A")
        set(_stl "UNKNOWN")
    endif()
    set(_dependencies "")
    foreach(_dependency IN LISTS PF_DEPENDENCIES)
        if(NOT TARGET "${_dependency}")
            message(FATAL_ERROR "Install preflight missing configured dependency: ${_dependency}")
        endif()
        get_target_property(_location "${_dependency}" IMPORTED_LOCATION_RELEASE)
        set(_configuration RELEASE)
        if(NOT _location OR _location MATCHES "-NOTFOUND$")
            get_target_property(_location "${_dependency}" IMPORTED_LOCATION)
            set(_configuration NOCONFIG)
        endif()
        if(NOT _location OR _location MATCHES "-NOTFOUND$")
            get_target_property(_configurations "${_dependency}" IMPORTED_CONFIGURATIONS)
            list(LENGTH _configurations _configuration_count)
            if(_configuration_count EQUAL 1)
                list(GET _configurations 0 _configuration)
                get_target_property(_location "${_dependency}" "IMPORTED_LOCATION_${_configuration}")
            endif()
        endif()
        if(NOT IS_ABSOLUTE "${_location}" OR NOT EXISTS "${_location}")
            message(FATAL_ERROR "Install preflight needs an actual dependency artifact: ${_dependency}")
        endif()
        file(SHA256 "${_location}" _hash)
        get_filename_component(_filename "${_location}" NAME)
        set(_version "${${_dependency}_VERSION}")
        if(NOT _version)
            # Some older upstream CONFIGs export the version string under this name.
            set(_version "${${_dependency}_VERSION_STRING}")
        endif()
        if(NOT _version MATCHES "^[0-9]+(\\.[0-9]+)+$")
            message(FATAL_ERROR "Install preflight cannot bind actual CONFIG version: ${_dependency}")
        endif()
        set(_link_files "")
        if(WIN32)
            get_target_property(_implib "${_dependency}" "IMPORTED_IMPLIB_${_configuration}")
            if(IS_ABSOLUTE "${_implib}" AND EXISTS "${_implib}")
                file(SHA256 "${_implib}" _implib_hash)
                get_filename_component(_implib_name "${_implib}" NAME)
                set(_link_files "{\"file\":\"${_implib_name}\",\"sha256\":\"${_implib_hash}\"}")
            endif()
        endif()
        if(_dependencies)
            string(APPEND _dependencies ",")
        endif()
        string(APPEND _dependencies "{\"name\":\"${_dependency}\",\"version\":\"${_version}\",\"configuration\":\"${_configuration}\",\"file\":\"${_filename}\",\"sha256\":\"${_hash}\",\"link_files\":[${_link_files}]}")
    endforeach()
    set(_files "")
    foreach(_target IN LISTS PF_TARGETS)
        get_target_property(_type "${_target}" TYPE)
        if(WIN32 AND _type STREQUAL "SHARED_LIBRARY")
            set(_directory "${CMAKE_INSTALL_BINDIR}")
        else()
            set(_directory "${CMAKE_INSTALL_LIBDIR}")
        endif()
        if(_files)
            string(APPEND _files ",")
        endif()
        string(APPEND _files "\"${_directory}/$<TARGET_FILE_NAME:${_target}>\"")
    endforeach()
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/preflight-$<CONFIG>/install-manifest.json")
    file(GENERATE OUTPUT "${_output}" CONTENT
        "{\"schema\":1,\"package\":\"${package}\",\"system\":\"${CMAKE_SYSTEM_NAME}\",\"architecture\":\"${_architecture}\",\"compiler\":\"${CMAKE_CXX_COMPILER_ID}\",\"compiler_version\":\"${CMAKE_CXX_COMPILER_VERSION}\",\"sdk_api\":\"${_sdk_api}\",\"sdk_version\":\"${_sdk_version}\",\"stl\":\"${_stl}\",\"experimental\":${experimental},\"dependencies\":[${_dependencies}],\"files\":[${_files}]}\n")
    install(FILES "${_output}" DESTINATION "${CMAKE_INSTALL_DATADIR}/${package}")
    install(FILES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts/install_preflight.py"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../examples/install_preflight.json"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../THIRD_PARTY_NOTICES.md"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../experiments/fastdds_socket/LICENSE.generated-Apache-2.0.txt"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/${package}")
endfunction()
