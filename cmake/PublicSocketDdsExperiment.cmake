option(BUILD_PUBLIC_SOCKET_BOUNDED_REGRESSION "Explicit bounded seven-case experiment and drop seam" OFF)
option(BUILD_PUBLIC_SOCKET_DECISION_DIAGNOSTICS "Explicit experiment decision observations, bounded and payload-free" OFF)
option(BUILD_PUBLIC_SOCKET_SHARED_REATTACH "Explicit two-view shared runtime experiment" OFF)
option(BUILD_PUBLIC_SOCKET_DDS_EXPERIMENT "Build isolated new-path DDS device experiment" OFF)
option(BUILD_PUBLIC_SOCKET_DDS_CONTRACT_TESTS "Host Fake C tests of the actual DDS experiment variant" OFF)
if(BUILD_PUBLIC_SOCKET_DDS_EXPERIMENT AND BUILD_PUBLIC_SOCKET_DDS_CONTRACT_TESTS)
    message(FATAL_ERROR "DDS_EXPERIMENT_TARGET_FAKE_EXCLUSIVE")
endif()
if(BUILD_PUBLIC_SOCKET_DDS_EXPERIMENT OR BUILD_PUBLIC_SOCKET_DDS_CONTRACT_TESTS)
    if(NOT MDDS_FASTDDS_MODE STREQUAL "CONFIG" OR NOT TARGET mdds_dsoftbus_native_send_execution OR NOT TARGET mdds_dsoftbus_service_record_binding)
        message(FATAL_ERROR "DDS experiment requires actual CONFIG/native send/Binding")
    endif()
    add_library(mdds_dds_experiment_adapter STATIC src/ProviderAdapter.cpp)
    target_compile_definitions(mdds_dds_experiment_adapter PUBLIC MDDS_PUBLIC_SOCKET_RUNTIME_PROBE=1 MDDS_PUBLIC_SOCKET_DDS_EXPERIMENT=1)
    target_link_libraries(mdds_dds_experiment_adapter PUBLIC mdds_dsoftbus_service_record_binding)
    set_property(TARGET mdds_dds_experiment_adapter PROPERTY INTERFACE_MDDS_PROVIDER_ADAPTER_VARIANT dds-experiment)
    set_property(TARGET mdds_dds_experiment_adapter APPEND PROPERTY COMPATIBLE_INTERFACE_STRING MDDS_PROVIDER_ADAPTER_VARIANT)
    add_library(mdds_dds_experiment_facade STATIC src/DSoftBusTransport.cpp src/DSoftBusTransportDescriptor.cpp src/HostProviderLoop.cpp)
    target_link_libraries(mdds_dds_experiment_facade PUBLIC mdds_dds_experiment_adapter mdds_dsoftbus_native_send_execution mdds_dsoftbus_input_channels)
    set_property(TARGET mdds_dds_experiment_facade PROPERTY INTERFACE_MDDS_FACADE_VARIANT dds-experiment)
    set_property(TARGET mdds_dds_experiment_facade APPEND PROPERTY COMPATIBLE_INTERFACE_STRING MDDS_FACADE_VARIANT)
    add_library(mdds_dds_experiment STATIC probes/PublicSocketDdsExperiment.cpp probes/PublicSocketDecisionTrace.cpp probes/PublicSocketRtpsObservation.cpp probes/PublicSocketRuntimeTrace.cpp src/PublicSocketBackend.cpp
        experiments/fastdds_socket/large_sample/ExperimentLargeSamplePubSubTypes.cxx
        experiments/fastdds_socket/large_sample/ExperimentLargeSampleTypeObjectSupport.cxx
        experiments/fastdds_socket/keyed/type/MddsKeyedSamplePubSubTypes.cxx
        experiments/fastdds_socket/keyed/type/MddsKeyedSampleTypeObjectSupport.cxx)
    target_include_directories(mdds_dds_experiment PUBLIC experiments/fastdds_socket/keyed/type experiments/fastdds_socket/large_sample PRIVATE "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport")
    target_link_libraries(mdds_dds_experiment PUBLIC mdds_dds_experiment_facade fastcdr)
    if(BUILD_PUBLIC_SOCKET_DECISION_DIAGNOSTICS)
        target_compile_definitions(mdds_dds_experiment PUBLIC MDDS_PUBLIC_SOCKET_DECISION_DIAGNOSTICS=1)
    endif()
    if(BUILD_PUBLIC_SOCKET_SHARED_REATTACH)
        target_compile_definitions(mdds_dds_experiment PUBLIC MDDS_PUBLIC_SOCKET_SHARED_REATTACH=1)
    endif()
    if(BUILD_PUBLIC_SOCKET_BOUNDED_REGRESSION)
        target_compile_definitions(mdds_dds_experiment PUBLIC MDDS_PUBLIC_SOCKET_BOUNDED_REGRESSION=1)
    endif()
    if(MSVC)
        target_compile_options(mdds_dds_experiment PRIVATE /EHsc-)
    endif()
    if(BUILD_PUBLIC_SOCKET_DDS_CONTRACT_TESTS)
        target_compile_definitions(mdds_dds_experiment PUBLIC MDDS_DDS_EXPERIMENT_TESTING=1)
        if(CMAKE_CROSSCOMPILING)
            message(FATAL_ERROR "DDS experiment Fake boundary tests require Host")
        endif()
        set_property(TARGET mdds_dds_experiment PROPERTY INTERFACE_MDDS_PUBLIC_SOCKET_VARIANT dds-contract-fake)
        add_executable(public_socket_dds_experiment_tests tests/public_socket_dds_experiment_tests.cpp tests/FakePublicSocketLink.cpp)
        target_include_directories(public_socket_dds_experiment_tests PRIVATE "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport")
        target_link_libraries(public_socket_dds_experiment_tests PRIVATE mdds_dds_experiment)
        if(BUILD_PUBLIC_SOCKET_SHARED_REATTACH)
            foreach(c SHARED_W1 SHARED_W2 SHARED_DELETE_FAILURE SHARED_CYCLE_2 SHARED_CYCLE_10 SHARED_CYCLE_100 sampling sampling-transition)
                add_test(NAME dsoftbus.dds_shared.${c} COMMAND public_socket_dds_experiment_tests ${c})
                set_tests_properties(dsoftbus.dds_shared.${c} PROPERTIES TIMEOUT 180)
                if(c STREQUAL "SHARED_CYCLE_100")
                    set_tests_properties(dsoftbus.dds_shared.${c} PROPERTIES TIMEOUT 1200)
                endif()
            endforeach()
        endif()
        add_executable(public_socket_rtps_observer_tests tests/public_socket_rtps_observer_tests.cpp probes/PublicSocketRtpsObservation.cpp)
        add_test(NAME dsoftbus.dds_experiment.rtps_observer COMMAND public_socket_rtps_observer_tests)
        if(BUILD_PUBLIC_SOCKET_BOUNDED_REGRESSION)
            add_executable(public_socket_fake_backpressure_tests tests/public_socket_fake_backpressure_tests.cpp tests/FakePublicSocketLink.cpp)
            target_compile_features(public_socket_fake_backpressure_tests PRIVATE cxx_std_17)
            target_include_directories(public_socket_fake_backpressure_tests PRIVATE "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport")
            foreach(mode pop close timeout)
                add_test(NAME dsoftbus.dds_regression.fake_${mode} COMMAND public_socket_fake_backpressure_tests ${mode})
            endforeach()
            foreach(c F256 F1M REL_LOSS BE_LOSS VOL_LATE TL_LATE KEYED_LAST BE_DELAYED_DROP)
                add_test(NAME dsoftbus.dds_regression.${c} COMMAND public_socket_dds_experiment_tests ${c})
                set_tests_properties(dsoftbus.dds_regression.${c} PROPERTIES TIMEOUT 180)
            endforeach()
        endif()
        foreach(c invalid stage-failure a-first b-first default trace terminal-status late-extra qos)
            add_test(NAME dsoftbus.dds_experiment.${c} COMMAND public_socket_dds_experiment_tests ${c})
            set_tests_properties(dsoftbus.dds_experiment.${c} PROPERTIES TIMEOUT 70)
        endforeach()
    else()
        if(NOT CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR NOT TARGET mdds_public_socket_api OR BUILD_DSOFTBUS_PUBLIC_SOCKET_FAKE_TESTS)
            message(FATAL_ERROR "DDS experiment target needs declared OHOS real Socket DSO, no Fake")
        endif()
        set_property(TARGET mdds_dds_experiment PROPERTY INTERFACE_MDDS_PUBLIC_SOCKET_VARIANT dds-device-real)
        target_link_libraries(mdds_dds_experiment PRIVATE mdds_public_socket_api)
        add_executable(public_socket_dds_experiment probes/public_socket_dds_main.cpp probes/token_first_entry.cpp)
        if(NOT EXISTS "${MDDS_RUNTIME_TOKEN_BRIDGE}" OR NOT IS_ABSOLUTE "${MDDS_RUNTIME_TOKEN_BRIDGE}")
            message(FATAL_ERROR "Declare freshly built token bridge")
        endif()
        string(LENGTH "${MDDS_RUNTIME_SOURCE_SHA256}" _dds_identity_length)
        if(NOT _dds_identity_length EQUAL 64 OR NOT MDDS_RUNTIME_SOURCE_SHA256 MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "DDS experiment requires source freeze digest")
        endif()
        file(SHA256 "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport/socket.h" _dds_socket_sha)
        file(SHA256 "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport/trans_type.h" _dds_type_sha)
        target_compile_definitions(public_socket_dds_experiment PRIVATE MDDS_RUNTIME_SOURCE_SHA256="${MDDS_RUNTIME_SOURCE_SHA256}" MDDS_RUNTIME_SOCKET_SHA256="${_dds_socket_sha}" MDDS_RUNTIME_TYPE_SHA256="${_dds_type_sha}")
        target_link_libraries(public_socket_dds_experiment PRIVATE mdds_dds_experiment "${MDDS_RUNTIME_TOKEN_BRIDGE}" ${CMAKE_DL_LIBS})
        target_link_options(public_socket_dds_experiment PRIVATE "-Wl,--no-undefined" "-Wl,--allow-shlib-undefined" "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/public_socket_dds_experiment.map")
        set_target_properties(public_socket_dds_experiment PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN")
    endif()
    set_property(TARGET mdds_dds_experiment APPEND PROPERTY COMPATIBLE_INTERFACE_STRING MDDS_PUBLIC_SOCKET_VARIANT)
endif()
