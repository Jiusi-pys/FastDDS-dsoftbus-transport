if(BUILD_PUBLIC_SOCKET_RUNTIME_PROBE AND BUILD_PUBLIC_SOCKET_RUNTIME_HOST_TESTS)
    message(FATAL_ERROR "RUNTIME_PROBE_VARIANTS_EXCLUSIVE")
endif()
if(BUILD_PUBLIC_SOCKET_RUNTIME_PROBE OR BUILD_PUBLIC_SOCKET_RUNTIME_HOST_TESTS)
    if(NOT TARGET mdds_dsoftbus_service_record_binding OR NOT TARGET mdds_dsoftbus_native_send_execution)
        message(FATAL_ERROR "Runtime probe needs existing Binding/native send components")
    endif()
    add_library(mdds_runtime_probe_adapter STATIC src/ProviderAdapter.cpp)
    target_compile_definitions(mdds_runtime_probe_adapter PUBLIC MDDS_PUBLIC_SOCKET_RUNTIME_PROBE=1)
    target_link_libraries(mdds_runtime_probe_adapter PUBLIC mdds_dsoftbus_service_record_binding)
    set_property(TARGET mdds_runtime_probe_adapter PROPERTY INTERFACE_MDDS_PROVIDER_ADAPTER_VARIANT runtime-probe)
    set_property(TARGET mdds_runtime_probe_adapter APPEND PROPERTY COMPATIBLE_INTERFACE_STRING MDDS_PROVIDER_ADAPTER_VARIANT)
    add_library(mdds_runtime_probe_assembly STATIC probes/PublicSocketRuntimeProbe.cpp probes/PublicSocketRuntimeTrace.cpp src/PublicSocketBackend.cpp)
    target_include_directories(mdds_runtime_probe_assembly PRIVATE "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport")
    target_link_libraries(mdds_runtime_probe_assembly PUBLIC mdds_runtime_probe_adapter mdds_dsoftbus_native_send_execution)
    if(MSVC)
        target_compile_options(mdds_runtime_probe_assembly PRIVATE /EHsc-)
    endif()
    if(BUILD_PUBLIC_SOCKET_RUNTIME_HOST_TESTS)
        if(CMAKE_CROSSCOMPILING)
            message(FATAL_ERROR "Runtime Fake C tests are host-only")
        endif()
        add_executable(public_socket_runtime_probe_tests tests/public_socket_runtime_probe_tests.cpp tests/FakePublicSocketLink.cpp)
        target_include_directories(public_socket_runtime_probe_tests PRIVATE "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport")
        target_link_libraries(public_socket_runtime_probe_tests PRIVATE mdds_runtime_probe_assembly)
        if(MSVC)
            target_compile_options(public_socket_runtime_probe_tests PRIVATE /EHsc-)
        endif()
        foreach(c records config load pair trace trace-text late-record negotiation2 token-outcome delayed-bind)
            add_test(NAME dsoftbus.runtime_probe.${c} COMMAND public_socket_runtime_probe_tests ${c})
            set_tests_properties(dsoftbus.runtime_probe.${c} PROPERTIES TIMEOUT 40)
        endforeach()
        set_tests_properties(dsoftbus.runtime_probe.trace-text PROPERTIES FAIL_REGULAR_EXPRESSION "PROBE_STAGE forged" PASS_REGULAR_EXPRESSION "text_hex=780a50524f42455f535441474520666f72676564")
    endif()
    if(BUILD_PUBLIC_SOCKET_RUNTIME_PROBE)
        if(NOT CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR BUILD_DSOFTBUS_PUBLIC_SOCKET_FAKE_TESTS)
            message(FATAL_ERROR "Runtime target requires OHOS and excludes Fake C")
        endif()
        if(NOT TARGET mdds_public_socket_api)
            message(FATAL_ERROR "Declare the audited real public Socket DSO target")
        endif()
        target_link_libraries(mdds_runtime_probe_assembly PRIVATE mdds_public_socket_api)
        add_executable(public_socket_runtime_probe probes/public_socket_runtime_main.cpp probes/token_first_entry.cpp)
        if(NOT EXISTS "${MDDS_RUNTIME_TOKEN_BRIDGE}" OR NOT IS_ABSOLUTE "${MDDS_RUNTIME_TOKEN_BRIDGE}")
            message(FATAL_ERROR "Runtime probe requires a newly built declared token bridge")
        endif()
        string(LENGTH "${MDDS_RUNTIME_SOURCE_SHA256}" _runtime_source_length)
        if(NOT _runtime_source_length EQUAL 64 OR NOT MDDS_RUNTIME_SOURCE_SHA256 MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "Runtime probe requires a frozen source receipt SHA256")
        endif()
        file(SHA256 "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport/socket.h" _runtime_socket_sha)
        file(SHA256 "${DSOFTBUS_SOURCE_DIR}/interfaces/kits/transport/trans_type.h" _runtime_type_sha)
        target_compile_definitions(public_socket_runtime_probe PRIVATE
            MDDS_RUNTIME_SOURCE_SHA256="${MDDS_RUNTIME_SOURCE_SHA256}"
            MDDS_RUNTIME_SOCKET_SHA256="${_runtime_socket_sha}"
            MDDS_RUNTIME_TYPE_SHA256="${_runtime_type_sha}")
        target_link_libraries(public_socket_runtime_probe PRIVATE mdds_runtime_probe_assembly "${MDDS_RUNTIME_TOKEN_BRIDGE}" ${CMAKE_DL_LIBS})
        target_link_options(public_socket_runtime_probe PRIVATE "-Wl,--no-undefined" "-Wl,--allow-shlib-undefined" "-Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/public_socket_runtime_probe.map")
        set_target_properties(public_socket_runtime_probe PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN")
    endif()
endif()
