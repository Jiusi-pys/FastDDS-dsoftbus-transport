add_executable(experiment_hot_scenario_tests hot_scenario_tests.cpp)
target_compile_features(experiment_hot_scenario_tests PRIVATE cxx_std_17)
target_link_libraries(experiment_hot_scenario_tests PRIVATE mdds_fastdds_binding)
foreach(_hot_case IN ITEMS HID1 HID2 HID3 HID4 HID5 SNAPSHOT OPTIONS FIXTURE LEDGER READY FAILURE EXCEPTION)
    add_test(NAME experiment.hot_${_hot_case} COMMAND experiment_hot_scenario_tests ${_hot_case})
    set_tests_properties(experiment.hot_${_hot_case} PROPERTIES TIMEOUT 10)
endforeach()
if(WIN32)
    add_custom_command(TARGET experiment_hot_scenario_tests POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "$<TARGET_FILE:fastdds>" "$<TARGET_FILE:fastcdr>" "$<TARGET_FILE:foonathan_memory>" "$<TARGET_FILE_DIR:experiment_hot_scenario_tests>")
endif()
add_executable(experiment_hot_close_tests hot_close_tests.cpp)
target_compile_features(experiment_hot_close_tests PRIVATE cxx_std_17)
foreach(_close_case IN ITEMS writer-error-physical-delete peer-drain-error-sticky contained-delete-participant-retry successful-idempotence)
    add_test(NAME experiment.hot_close_${_close_case} COMMAND experiment_hot_close_tests ${_close_case})
    set_tests_properties(experiment.hot_close_${_close_case} PROPERTIES TIMEOUT 10)
endforeach()
