if(CASE STREQUAL "missing_library")
    set(args --library "${FIXTURE}.does-not-exist")
    set(expected_exit 2)
    set(expected_output "stage=load result=FAIL")
elseif(CASE STREQUAL "missing_required")
    set(args --library "${INCOMPLETE}")
    set(expected_exit 2)
    set(expected_output "symbol=SendBytes required=true present=false")
elseif(CASE STREQUAL "optional_absent")
    set(args --library "${FIXTURE}")
    set(expected_exit 0)
    set(expected_output "symbol=BindAsync required=false present=false")
elseif(CASE STREQUAL "socket_rejected")
    set(args --library "${FIXTURE}" --socket-check)
    set(expected_exit 3)
    set(expected_output "stage=Socket result=FAIL code=-201")
elseif(CASE STREQUAL "socket_closed")
    set(args --library "${SUCCESS}" --socket-check)
    set(expected_exit 0)
    set(expected_output "fixture=Shutdown id=42 calls=1")
elseif(CASE STREQUAL "usage")
    set(args --unknown-option)
    set(expected_exit 64)
    set(expected_output "Usage:")
else()
    message(FATAL_ERROR "Unknown test case ${CASE}")
endif()

execute_process(COMMAND "${PROBE}" ${args}
    RESULT_VARIABLE actual_exit OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "${CASE}: expected exit ${expected_exit}, got ${actual_exit}\n${output}\n${errors}")
endif()
set(combined "${output}\n${errors}")
string(FIND "${combined}" "${expected_output}" match)
if(match EQUAL -1)
    message(FATAL_ERROR "${CASE}: missing output '${expected_output}'\n${combined}")
endif()
if(CASE STREQUAL "optional_absent")
    string(FIND "${combined}" "stage=symbols result=PASS communication=NOT_RUN" summary_match)
    if(summary_match EQUAL -1)
        message(FATAL_ERROR "Missing bounded capability result: ${combined}")
    endif()
endif()
if(CASE STREQUAL "socket_closed")
    string(REGEX MATCHALL "fixture=Shutdown[^\n]*" shutdown_calls "${combined}")
    list(LENGTH shutdown_calls shutdown_count)
    if(NOT shutdown_count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one fixture-observed Shutdown: ${combined}")
    endif()
    string(FIND "${combined}" "quiescence=NOT_VERIFIED communication=NOT_RUN" boundary_match)
    if(boundary_match EQUAL -1)
        message(FATAL_ERROR "Do not promote Shutdown return to quiescence: ${combined}")
    endif()
elseif(CASE STREQUAL "socket_rejected")
    string(FIND "${combined}" "fixture=Shutdown" unexpected_close)
    if(NOT unexpected_close EQUAL -1)
        message(FATAL_ERROR "Failed Socket must not be closed: ${combined}")
    endif()
endif()
message(STATUS "${CASE}: PASS")
